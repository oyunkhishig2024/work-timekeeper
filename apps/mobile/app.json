{
  "expo": {
    "name": "Timekeeper Work",
    "slug": "timekeeper-work",
    "scheme": "tkw",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "mn.timekeeper.work",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "mn.timekeeper.work",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "versionCode": 1,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Ирцийг ажлын байрны орчимд автоматаар бүртгэхийн тулд байршлыг үргэлж ашиглахыг зөвшөөрнө үү. Байршлыг зөвхөн ажлын цагаар, ажлын байрны орчимд ашиглана.",
          "locationWhenInUsePermission": "Ирцийг бүртгэхийн тулд байршлыг ашиглана."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Утсаа бүртгүүлэхэд QR код уншуулахын тулд камер ашиглана.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F766E",
          "imageWidth": 200
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001"
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
