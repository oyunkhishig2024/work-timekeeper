# Use this Caddyfile ONLY when the domain is proxied through Cloudflare (orange cloud) AND the DigitalOcean firewall lets
# only Cloudflare reach ports 80 and 443 (docs/security/cloudflare-digitalocean-caddy.md). Cloudflare puts the visitor's real
# address in CF-Connecting-IP; here it replaces X-Forwarded-For, which the API reads for rate limiting and bans (TRUST_PROXY=1).
# If the server were reachable directly, anybody could forge that header, so never use this file without the firewall rule.
{$DOMAIN} {
	encode zstd gzip
	# Tell browsers to use HTTPS only (one year). No includeSubDomains/preload: the domain may be shared.
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	handle /v1/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}
	# Web pages. Next.js labels its pages "s-maxage=31536000" (one year), which a CDN would obey, serving old HTML that points at
	# script files a new deploy has removed. HTML is therefore always re-checked (a cheap 304 when unchanged). The fingerprinted files
	# under /_next/static keep the year-long "immutable" Next.js gives them; sw.js keeps its own no-cache rule.
	handle /_next/static/* {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}
	handle /sw.js {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}
	@small path /icon.svg /manifest.webmanifest
	handle @small {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
			header_down Cache-Control "public, max-age=86400"
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
			header_down Cache-Control "no-cache"
		}
	}
}
