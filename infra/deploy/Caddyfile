# Caddy gets and renews the HTTPS certificate by itself. {$DOMAIN} comes from .env.
{$DOMAIN} {
	encode zstd gzip
	# Tell browsers to use HTTPS only (one year). No includeSubDomains/preload: the domain may be shared.
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	handle /v1/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:3000
	}
}
