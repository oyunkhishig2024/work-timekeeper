# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://timekeeper:timekeeper@localhost:5432/timekeeper
NODE_ENV=development
API_PORT=3001

# Secrets (REQUIRED, no defaults). Generate real values; never reuse these examples.
#   JWT_SECRET           openssl rand -base64 48      signs access tokens
#   DATA_ENCRYPTION_KEY  openssl rand -base64 32      encrypts TOTP secrets, keys recovery-code hashes
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Device attestation: disabled (records UNVERIFIED) or enforce (verifier not built yet -> 503). See apps/api/src/devices/README.md
ATTESTATION_MODE=disabled
# Uploaded files (consent scans) in local development
STORAGE_DIR=./storage

# Optional tuning (defaults shown): ACCESS_TOKEN_TTL_SECONDS=900, STAFF_SESSION_IDLE_MINUTES=30,
# EMPLOYEE_SESSION_DAYS=30, LOGIN_MAX_FAILURES=5, LOGIN_LOCK_MINUTES=15, AUTH_RATE_LIMIT_PER_MINUTE=10, QR_ONBOARDING_HOURS=72, QR_REPLACEMENT_HOURS=24

# Reverse proxy and abuse protection (docs/security, apps/api/src/security/README.md). TRUST_PROXY = number of proxies in front of
# the API (1 = nginx on the same server) or a list of trusted addresses; wrong values let clients fake their IP.
TRUST_PROXY=1
ABUSE_PROTECTION=on
# Never throttled or banned (office, uptime monitor), comma separated IPs / CIDRs:
ABUSE_ALLOWLIST=
# Tuning (defaults shown): ABUSE_THROTTLE_SCORE=40, ABUSE_BAN_SCORE=100, ABUSE_THROTTLE_PER_MINUTE=20,
# ABUSE_ANON_BURST_PER_10S=100, ABUSE_AUTH_BURST_PER_10S=400
# Several API instances: share the per-IP judgement through Redis (unset = in-process memory, single instance).
# Bind Redis to 127.0.0.1 / a private network and use a password (see apps/api/src/security/README.md).
REDIS_URL=
ABUSE_REDIS_PREFIX=tk:abuse:
# Redis command timeout (ms), failures in a row that switch to local memory, seconds before Redis is tried again:
# ABUSE_REDIS_TIMEOUT_MS=200, ABUSE_REDIS_BREAKER_FAILURES=3, ABUSE_REDIS_BREAKER_COOLDOWN_SECONDS=15

# Integration tests (apps/api/test/db). The database name MUST end with _test: the schema is dropped
# and rebuilt from the migrations on every run. Tests are skipped when this is unset.
TEST_DATABASE_URL=postgres://timekeeper:timekeeper@localhost:5432/timekeeper_test
